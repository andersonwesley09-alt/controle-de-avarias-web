/* CONTROLE DE AVARIAS - V24.11
   Quando um HTML for aberto por duplo clique (file://), o navegador
   nao sabe qual PC hospeda o servidor. Nesta situacao pedimos o endereco
   somente uma vez e validamos /api/versao antes de redirecionar.
   Quando o sistema ja esta em http://, nao fazemos absolutamente nada.
*/
(() => {
    if (window.location.protocol !== "file:") return;

    const CHAVE = "controleAvariasServidor";
    const DEFAULT_SERVER = "http://localhost:3000";

    function normalizar(valor) {
        try {
            const u = new URL(String(valor || "").trim());
            if (!/^https?:$/.test(u.protocol)) return "";
            return u.origin;
        } catch {
            return "";
        }
    }

    function obterConfigurado() {
        try {
            const porUrl = new URLSearchParams(window.location.search).get("servidor");
            const url = normalizar(porUrl);
            if (url) {
                localStorage.setItem(CHAVE, url);
                return url;
            }

            return normalizar(localStorage.getItem(CHAVE)) || DEFAULT_SERVER;
        } catch {
            return DEFAULT_SERVER;
        }
    }

    function arquivoAtual() {
        const nome = String(window.location.pathname || "").split(/[\\/]/).pop();
        return /\.html?$/i.test(nome) ? nome : "index.html";
    }

    async function testarServidor(base) {
        const resposta = await fetch(`${base}/api/versao?ts=${Date.now()}`, {
            cache: "no-store",
            credentials: "include"
        });

        const tipo = String(resposta.headers.get("content-type") || "").toLowerCase();
        if (!resposta.ok || !tipo.includes("application/json")) return false;

        const dados = await resposta.json();
        return dados?.ok === true && /^V\d+(?:\.\d+)*$/.test(String(dados?.versao || ""));
    }

    async function iniciar() {
        let servidor = obterConfigurado();

        if (!servidor) servidor = DEFAULT_SERVER;

        try {
            if (await testarServidor(servidor)) {
                const arquivo = arquivoAtual();
                window.location.replace(`${servidor}/${arquivo}`);
                return;
            }
        } catch {}

        const informado = window.prompt(
            "Servidor do Controle de Avarias não encontrado.\n\nDigite o endereço do servidor, por exemplo:\nhttp://192.168.1.20:3000",
            servidor
        );

        const novoServidor = normalizar(informado);
        if (!novoServidor) {
            document.documentElement.innerHTML = `
                <body style="font-family:Arial,sans-serif;padding:40px;line-height:1.5">
                    <h2>Servidor não configurado</h2>
                    <p>Abra <strong>ABRIR_DASHBOARD.bat</strong> no computador principal ou informe o endereço HTTP do servidor.</p>
                </body>`;
            return;
        }

        try {
            if (!await testarServidor(novoServidor)) throw new Error("Servidor inválido");
            localStorage.setItem(CHAVE, novoServidor);
            const arquivo = arquivoAtual();
            window.location.replace(`${novoServidor}/${arquivo}`);
        } catch {
            alert("Não foi possível encontrar o servidor nesse endereço. Verifique o IP e se o INICIAR_SERVIDOR.bat está aberto.");
        }
    }

    iniciar();
})();
